# Copy to .env for local CLI use. In CI the same names are GitHub Actions secrets.
# Secrets never go into drift.config.json.

# Telegram bot that receives leads, sync reports and the daily digest (@BotFather).
TELEGRAM_BOT_TOKEN=

# Shared secret between the CLI/CI and the Cloudflare Worker admin API. Generate: openssl rand -hex 32
DRIFT_ADMIN_TOKEN=
# Read-only token typed once into the /dash/ page. Generate: openssl rand -hex 16
DRIFT_DASHBOARD_TOKEN=

# Optional: email relay for leads (https://resend.com free tier). Leave empty to skip email.
RESEND_API_KEY=
# Optional: Cloudflare Turnstile secret for contact-form bot protection.
TURNSTILE_SECRET_KEY=

# Cloudflare account (needed by `drift deploy worker` and the deploy-worker workflow).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
